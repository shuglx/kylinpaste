{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "KylinPaste",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false
    },
    "windows": [
      {
        "label": "main",
        "title": "KylinPaste 剪贴板",
        "width": 440,
        "height": 660,
        "minWidth": 320,
        "minHeight": 400,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "systemTray": {
      "iconPath": "icons/tray.png"
    },
    "bundle": {
      "identifier": "com.kylinpaste.app",
      "active": true,
      "targets": ["deb"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/256x256.png",
        "icons/512x512.png",
        "icons/icon.png"
      ],
      "deb": {
        "depends": [
          "libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libappindicator3-1",
          "libxkbcommon0"
        ]
      }
    }
  }
}
