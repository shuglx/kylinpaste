{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "KylinPaste",
    "version": "1.3.3"
  },
  "tauri": {
    "macOSPrivateApi": true,
    "allowlist": {
      "all": false,
      "window": {
        "startDragging": true
      },
      "shell": {
        "open": true
      },
      "protocol": {
        "asset": true,
        "assetScope": ["$APPDATA/clipboard_images/**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "KylinPaste 剪贴板",
        "width": 720,
        "height": 480,
        "minWidth": 520,
        "minHeight": 350,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "identifier": "com.kylinpaste.app",
      "active": true,
      "targets": ["deb"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/256x256.png",
        "icons/512x512.png",
        "icons/icon.icns"
      ],
      "deb": {
        "depends": [
          "libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libxkbcommon0"
        ]
      }
    }
  }
}
